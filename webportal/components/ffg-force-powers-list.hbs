{{!-- Force Powers Summary --}}
<div class="mb-3">
  <strong>Selected Powers:</strong> {{this.selectedPowersCount}} / {{this.totalPowers}}
  <div class="mt-2">
    <span class="badge bg-info">
      Total XP Cost: {{this.totalXPCost}} XP
    </span>
  </div>
</div>

{{!-- Selected Powers --}}
{{#if this.selectedPowers.length}}
  <div class="mb-4">
    <h5>Your Force Powers</h5>
    {{#each this.selectedPowers as |power|}}
      <div class="card mb-2">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h6 class="mb-1">{{power.name}}</h6>
              <p class="small text-muted mb-2">{{power.description}}</p>
              {{#if power.selectedUpgrades.length}}
                <div class="small">
                  <strong>Upgrades:</strong>
                  {{#each power.selectedUpgrades as |upgrade|}}
                    <span class="badge bg-secondary me-1">
                      {{upgrade.name}}
                      {{#if (gt upgrade.count 1)}}x{{upgrade.count}}{{/if}}
                    </span>
                  {{/each}}
                </div>
              {{/if}}
            </div>
            <div class="col-md-4 text-end">
              <button
                type="button"
                class="btn btn-sm btn-danger mb-2"
                {{on "click" (fn this.removePower power.name)}}
              >
                Remove Power
              </button>
              <br>
              <button
                type="button"
                class="btn btn-sm btn-primary"
                {{on "click" (fn this.manageUpgrades power.name)}}
              >
                Manage Upgrades
              </button>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{/if}}

{{!-- Available Powers to Add --}}
<div>
  <h5>Available Force Powers</h5>
  <table class="table table-sm table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th class="text-center">Base Cost</th>
        <th class="text-center">Action</th>
      </tr>
    </thead>
    <tbody>
      {{#each this.availablePowers as |power|}}
        <tr>
          <td><strong>{{power.name}}</strong></td>
          <td class="small">{{power.description}}</td>
          <td class="text-center">{{power.base_xp_cost}} XP</td>
          <td class="text-center">
            <button
              type="button"
              class="btn btn-sm btn-success"
              {{on "click" (fn this.addPower power.name)}}
            >
              Add
            </button>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{!-- Upgrade Selection Modal (shown when managing upgrades) --}}
{{#if this.showingUpgradesFor}}
  <div class="modal show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Manage Upgrades for {{this.showingUpgradesFor}}</h5>
          <button type="button" class="btn-close" {{on "click" this.closeUpgrades}}></button>
        </div>
        <div class="modal-body">
          {{#each this.currentPowerUpgrades as |upgrade|}}
            <div class="mb-3 p-2 border rounded">
              <div class="row align-items-center">
                <div class="col-md-8">
                  <strong>{{upgrade.name}}</strong>
                  <span class="small text-muted"> - {{upgrade.xp_cost}} XP each</span>
                  {{#if upgrade.prereq}}
                    <span class="badge bg-warning">Requires: {{upgrade.prereq}}</span>
                  {{/if}}
                  <p class="small mb-0">{{upgrade.description}}</p>
                  {{#if (gt upgrade.max_rank 1)}}
                    <span class="small text-info">Can purchase up to {{upgrade.max_rank}} times</span>
                  {{/if}}
                </div>
                <div class="col-md-4 text-end">
                  <div class="btn-group" role="group">
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-danger"
                      {{on "click" (fn this.decreaseUpgrade upgrade.name)}}
                      disabled={{eq upgrade.current 0}}
                    >
                      -
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                      {{upgrade.current}} / {{upgrade.max_rank}}
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-success"
                      {{on "click" (fn this.increaseUpgrade upgrade.name)}}
                      disabled={{gte upgrade.current upgrade.max_rank}}
                    >
                      +
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" {{on "click" this.closeUpgrades}}>Done</button>
        </div>
      </div>
    </div>
  </div>
{{/if}}
