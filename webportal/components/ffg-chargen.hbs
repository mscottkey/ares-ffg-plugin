<section class="sheet-section">
  <h2>FFG Character Creation</h2>

  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a href="#ffg-basics" class="nav-link active" role="tab" data-bs-toggle="tab">
        Basics
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-chars" class="nav-link" role="tab" data-bs-toggle="tab">
        Characteristics
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-skills" class="nav-link" role="tab" data-bs-toggle="tab">
        Skills
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-talents" class="nav-link" role="tab" data-bs-toggle="tab">
        Talents
      </a>
    </li>
  </ul>

  <div class="tab-content" style="margin-top:1rem;">
    {{! Basics - Combined Archetype/Career/Specs }}
    <div class="tab-pane active" id="ffg-basics" role="tabpanel">
      <h3>Basics</h3>
      <p class="text-muted">
        Choose your character's archetype (species/origin), career, and specializations.
      </p>
      
      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label"><strong>Archetype / Species</strong></label>
          <select class="form-select" {{on "change" (action "selectArchetype")}}>
            <option value="">-- Choose Archetype --</option>
            {{#each this.cgInfo.archetypes as |arch|}}
              <option
                value={{arch.name}}
                selected={{eq arch.name this.char.archetype.name}}
              >
                {{arch.name}}
              </option>
            {{/each}}
          </select>
          
          {{#if this.char.archetype}}
            <div class="mt-2 p-2 bg-light border rounded">
              <strong>{{this.char.archetype.name}}</strong><br>
              <small>
                Wound Threshold: {{this.char.archetype.wound}} • 
                Strain Threshold: {{this.char.archetype.strain}} • 
                Starting XP: {{this.char.archetype.xp}}
              </small>
              {{#if this.char.archetype.characteristics}}
                <div class="mt-1">
                  <small><strong>Starting Characteristics:</strong></small><br>
                  <small>
                    {{#each-in this.char.archetype.characteristics as |name value|}}
                      {{name}}: {{value}}&nbsp;&nbsp;
                    {{/each-in}}
                  </small>
                </div>
              {{/if}}
            </div>
          {{/if}}
        </div>

        <div class="col-md-6">
          <label class="form-label"><strong>Career</strong></label>
          <select class="form-select" {{on "change" (action "selectCareer")}}>
            <option value="">-- Choose Career --</option>
            {{#each this.cgInfo.careers as |car|}}
              <option
                value={{car.name}}
                selected={{eq car.name this.char.career.name}}
              >
                {{car.name}}
              </option>
            {{/each}}
          </select>

          {{#if this.char.career}}
            <div class="mt-2 p-2 bg-light border rounded">
              <strong>{{this.char.career.name}}</strong><br>
              <small><strong>Career Skills:</strong></small><br>
              <small>
                {{#each this.char.career.career_skills as |skill index|}}
                  {{skill}}{{#unless (eq index (sub this.char.career.career_skills.length 1))}}, {{/unless}}
                {{/each}}
              </small>
            </div>
          {{/if}}
        </div>
      </div>

      {{! Specializations Section }}
      {{#if this.cgInfo.specializations}}
        <div class="mt-4">
          <h4>Specializations</h4>
          <p class="text-muted small">
            Your first specialization is free. Additional specializations cost XP.
            Specializations grant additional career skills and may unlock talents.
          </p>

          <div class="row">
            <div class="col-md-6">
              <div class="input-group mb-2">
                <select class="form-select" {{on "change" (action "updateSpecSelection")}}>
                  <option value="">-- Select a Specialization --</option>
                  {{#each this.availableSpecs as |spec|}}
                    <option value={{spec.name}}>
                      {{spec.name}}
                      {{#if spec.career}}
                        ({{spec.career}})
                      {{else}}
                        (Universal)
                      {{/if}}
                    </option>
                  {{/each}}
                </select>
                <button 
                  class="btn btn-primary" 
                  {{on "click" (action "addSpecialization")}}
                  disabled={{not this.selectedSpecName}}
                >
                  Add
                </button>
              </div>
            </div>
          </div>

          {{#if this.char.specializations}}
            <div class="mt-3">
              <strong>Your Specializations:</strong>
              <ul class="list-group mt-2">
                {{#each this.char.specializations as |spec index|}}
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <strong>{{spec.name}}</strong>
                      {{#if spec.career}}
                        <span class="badge bg-secondary">{{spec.career}}</span>
                      {{else}}
                        <span class="badge bg-info">Universal</span>
                      {{/if}}
                      {{#if spec.force_user}}
                        <span class="badge bg-warning">Force User</span>
                      {{/if}}
                      {{#if (eq index 0)}}
                        <span class="badge bg-success">Free</span>
                      {{/if}}
                      {{#if spec.career_skills}}
                        <br>
                        <small class="text-muted">
                          Skills: 
                          {{#each spec.career_skills as |skill skillIndex|}}
                            {{skill}}{{#unless (eq skillIndex (sub spec.career_skills.length 1))}}, {{/unless}}
                          {{/each}}
                        </small>
                      {{/if}}
                    </div>
                    <button 
                      class="btn btn-sm btn-danger" 
                      {{on "click" (fn this.removeSpecialization spec.name)}}
                    >
                      Remove
                    </button>
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/if}}
        </div>
      {{/if}}

      {{! XP Summary }}
      {{#if this.char.archetype}}
        <div class="mt-4 p-3 bg-info bg-opacity-10 border border-info rounded">
          <h5>Experience Points (XP)</h5>
          <div class="row">
            <div class="col-md-4">
              <strong>Starting XP:</strong> {{this.char.starting_xp}}
            </div>
            <div class="col-md-4">
              <strong>Current XP:</strong> {{this.char.current_xp}}
            </div>
            <div class="col-md-4">
              <strong>Spent XP:</strong> {{this.spentXP}}
            </div>
          </div>
        </div>
      {{/if}}
    </div>

    {{! Characteristics }}
    <div id="ffg-chars" class="tab-pane" role="tabpanel">
      <h3>Characteristics</h3>
      <p class="text-muted">
        Characteristics represent your character's raw physical and mental attributes.
        Maximum rating in chargen: {{this.cgInfo.max_cg_characteristic_rating}}
      </p>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Characteristic</th>
            <th>Description</th>
            <th class="text-center">Rating</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.char.characteristics as |c|}}
            <FfgCharacteristicRow
              @charac={{c}}
              @maxRating={{this.cgInfo.max_cg_characteristic_rating}}
              @updated={{action "abilityChanged"}}
            />
          {{/each}}
        </tbody>
      </table>
    </div>

    {{! Skills }}
    <div id="ffg-skills" class="tab-pane" role="tabpanel">
      <h3>Skills</h3>
      <p class="text-muted">
        Skills represent your character's training and expertise.
        Maximum rating in chargen: {{this.cgInfo.max_cg_skill_rating}}
        <br>
        <strong>Career skills</strong> are highlighted and cost less XP to improve.
        You must take at least {{this.cgInfo.min_career_skills}} career skills.
      </p>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Skill</th>
            <th>Characteristic</th>
            <th class="text-center">Career Skill?</th>
            <th class="text-center">Rating</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.char.skills as |s|}}
            <tr class="{{if s.is_career 'table-success'}}">
              <td>
                <strong>{{s.name}}</strong>
                {{#if s.desc}}
                  <br><small class="text-muted">{{s.desc}}</small>
                {{/if}}
              </td>
              <td>{{s.characteristic}}</td>
              <td class="text-center">
                {{#if s.is_career}}
                  <span class="badge bg-success">Yes</span>
                {{else}}
                  <span class="badge bg-secondary">No</span>
                {{/if}}
              </td>
              <td>
                <FfgSkillRow
                  @skill={{s}}
                  @maxRating={{this.cgInfo.max_cg_skill_rating}}
                  @updated={{action "abilityChanged"}}
                />
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{! Talents }}
    <div id="ffg-talents" class="tab-pane" role="tabpanel">
      <h3>Talents</h3>
      <p class="text-muted">
        Talents are special abilities that make your character unique.
        You must maintain a balanced talent pyramid - you need more talents at lower tiers
        to support higher tier talents.
      </p>
      <FfgTalentsList
        @char={{this.char}}
        @cgInfo={{this.cgInfo}}
        @updated={{action "abilityChanged"}}
      />
    </div>
  </div>
</section>