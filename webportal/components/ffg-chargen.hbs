<section class="sheet-section">
  <h2>FFG Character Creation</h2>

  {{!-- Debug panel so we can see what the backend is sending --}}
  <div style="padding:10px; background:#222; color:#0f0; margin-bottom:1rem;">
    <div><b>DEBUG:</b> char = {{this.char}}</div>
    <div><b>DEBUG:</b> cg_info = {{this.cgInfo}}</div>
  </div>

  {{!-- High-level summary if it exists (similar to SheetTemplate#to_h) --}}
  {{#if this.char.summary}}
    <p><b>Summary:</b> {{this.char.summary}}</p>
  {{/if}}

  <ul class="nav nav-tabs" role="tablist">
     <li class="nav-item" role="presentation">
      <a href="#ffg-archetype" class="nav-link" role="tab" data-bs-toggle="tab">
        Archetype
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-career" class="nav-link" role="tab" data-bs-toggle="tab">
        Career
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-specializations" class="nav-link" role="tab" data-bs-toggle="tab">
        Specializations
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-chars" class="nav-link active" role="tab" data-bs-toggle="tab">
        Characteristics
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-skills" class="nav-link" role="tab" data-bs-toggle="tab">
        Skills
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-talents" class="nav-link" role="tab" data-bs-toggle="tab">
        Talents
      </a>
    </li>
  </ul>

  <div class="tab-content" style="margin-top:1rem;">

    {{!-- Archetype --}}

    <div class="tab-pane" id="ffg-archetype" role="tabpanel">
      <h3>Archetype</h3>
      <select {{on "change" this.selectArchetype}}>
        <option value="">-- Choose Archetype --</option>
        {{#each this.cgInfo.archetypes as |arch|}}
          <option
            value={{arch.name}}
            selected={{eq arch.name this.ffg.archetype.name}}
          >
            {{arch.name}}
          </option>
        {{/each}}
      </select>

      {{#if this.ffg.archetype}}
        <p class="mt-2">
          Wounds: {{this.ffg.wounds.max}} • Strain: {{this.ffg.strain.max}} • XP: {{this.ffg.starting_xp}}
        </p>
      {{/if}}
    </div>

    {{!-- Career --}}

    <div class="tab-pane" id="ffg-career" role="tabpanel">
      <h3>Career</h3>
      <select {{on "change" this.selectCareer}}>
        <option value="">-- Choose Career --</option>
        {{#each this.cgInfo.careers as |car|}}
          <option
            value={{car.name}}
            selected={{eq car.name this.ffg.career.name}}
          >
            {{car.name}}
          </option>
        {{/each}}
      </select>

      {{#if this.ffg.career}}
        <p class="mt-2">Career Skills:</p>
        <ul>
          {{#each this.ffg.career.career_skills as |skill|}}
            <li>{{skill}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </div>

    {{!-- Specializations --}}

    <div class="tab-pane" id="ffg-specializations" role="tabpanel">
      <h3>Specializations</h3>

      <div class="mb-2">
        <select {{on "change" this.updateSpecSelection}}>
          <option value="">-- Add Specialization --</option>
          {{#each this.cgInfo.specializations as |spec|}}
            <option value={{spec.name}}>
              {{spec.name}} {{#if spec.career}}({{spec.career}}){{/if}}
            </option>
          {{/each}}
        </select>
        <button class="btn btn-primary btn-sm ms-2" {{on "click" this.addSpecialization}}>
          Add
        </button>
      </div>

      <ul>
        {{#each this.ffg.specializations as |spec|}}
          <li>
            {{spec.name}}
            {{#if spec.career}} ({{spec.career}}) {{/if}}
            {{#if spec.force_user}} • Force User {{/if}}
          </li>
        {{/each}}
      </ul>
    </div>
    {{!-- Characteristics --}}
    <div id="ffg-chars" class="tab-pane active" role="tabpanel">
      <h3>Characteristics</h3>
      {{#if this.char.characteristics}}
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Characteristic</th>
              <th>Rating</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.char.characteristics as |c|}}
              <FfgCharacteristicRow
                @charac={{c}}
                @maxRating={{this.cgInfo.max_cg_characteristic_rating}}
                @updated={{this.updated}}
              />
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p>No characteristics found in char.characteristics.</p>
      {{/if}}
    </div>

    {{!-- Skills --}}
    <div id="ffg-skills" class="tab-pane" role="tabpanel">
      <h3>Skills</h3>
      {{!-- Use our reusable skills table component which renders rows via <FfgSkillRow /> --}}
      <FfgSkillsRow
        @char={{this.char}}
        @maxRating={{this.cgInfo.max_cg_skill_rating}}
        @updated={{this.updated}}
      />
    </div>

    {{!-- Talents --}}
    <div id="ffg-talents" class="tab-pane" role="tabpanel">
      <h3>Talents</h3>
      <FfgTalentsList
        @char={{this.char}}
        @cgInfo={{this.cgInfo}}
        @addTalent={{action "addTalent"}}
        @removeTalent={{action "removeTalent"}}
        @updated={{this.updated}}
      />
    </div>

  </div>
</section>
