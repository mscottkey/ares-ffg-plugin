<section class="sheet-section">
  <h2>FFG Character Creation</h2>

  {{! XP Summary Bar - Shows on ALL tabs }}
  {{#if this.char.custom.ffg.archetype}}
    <div class="alert alert-primary mb-3">
      <div class="row">
        <div class="col-md-4">
          <strong>Starting XP:</strong> {{this.char.custom.ffg.starting_xp}}
        </div>
        <div class="col-md-4">
          <strong>Current XP:</strong> {{this.char.custom.ffg.currentXP}}
        </div>
        <div class="col-md-4">
          <strong>Spent XP:</strong> {{this.spentXP}}
        </div>
      </div>
    </div>
  {{/if}}

  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
      <a href="#ffg-basics" class="nav-link active" role="tab" data-bs-toggle="tab">
        Basics
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-chars" class="nav-link" role="tab" data-bs-toggle="tab">
        Characteristics
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-skills" class="nav-link" role="tab" data-bs-toggle="tab">
        Skills
      </a>
    </li>
    <li class="nav-item" role="presentation">
      <a href="#ffg-talents" class="nav-link" role="tab" data-bs-toggle="tab">
        Talents
      </a>
    </li>
  </ul>

  <div class="tab-content" style="margin-top:1rem;">
    {{! Basics - Combined Archetype/Career/Specs }}
    <div class="tab-pane active" id="ffg-basics" role="tabpanel">
      <h3>Basics</h3>
      <p>
        Choose your character's archetype (species/origin), career, and specializations.
      </p>
      
      <div class="row mb-3">
        <div class="col-md-6">
          <label class="form-label"><strong>Archetype / Species</strong></label>
          <select class="form-select" {{on "change" (action "selectArchetype")}}>
            <option value="">-- Choose Archetype --</option>
            {{#each this.char.custom.cg_ffg.archetypes as |arch|}}
              <option
                value={{arch.name}}
                selected={{eq arch.name this.char.custom.ffg.archetype.name}}
              >
                {{arch.name}}
              </option>
            {{/each}}
          </select>
          
          {{#if this.char.custom.ffg.archetype}}
            <div class="alert alert-info mt-2">
              <strong>{{this.char.custom.ffg.archetype.name}}</strong><br>
              <small>
                Wound Threshold: {{this.char.custom.ffg.archetype.wound}} • 
                Strain Threshold: {{this.char.custom.ffg.archetype.strain}} • 
                Starting XP: {{this.char.custom.ffg.archetype.xp}}
              </small>
              {{#if this.char.custom.ffg.archetype.characteristics}}
                <div class="mt-1">
                  <small><strong>Starting Characteristics:</strong></small><br>
                  <small>
                    {{#each-in this.char.custom.ffg.archetype.characteristics as |name value|}}
                      {{name}}: {{value}}&nbsp;&nbsp;
                    {{/each-in}}
                  </small>
                </div>
              {{/if}}
            </div>
          {{/if}}
        </div>

        <div class="col-md-6">
          <label class="form-label"><strong>Career</strong></label>
          <select class="form-select" {{on "change" (action "selectCareer")}}>
            <option value="">-- Choose Career --</option>
            {{#each this.char.custom.cg_ffg.careers as |car|}}
              <option
                value={{car.name}}
                selected={{eq car.name this.char.custom.ffg.career.name}}
              >
                {{car.name}}
              </option>
            {{/each}}
          </select>

          {{#if this.char.custom.ffg.career}}
            <div class="alert alert-info mt-2">
              <strong>{{this.char.custom.ffg.career.name}}</strong><br>
              {{#if this.char.custom.ffg.career.career_skills}}
                <small><strong>Career Skills:</strong></small><br>
                <small>
                  {{#each this.char.custom.ffg.career.career_skills as |skill|}}
                    {{skill}}{{#if @last}}{{else}}, {{/if}}
                  {{/each}}
                </small>
              {{/if}}
            </div>
          {{/if}}
        </div>
      </div>

      {{! Specializations Section }}
      {{#if this.char.custom.cg_ffg.specializations}}
        <div class="mt-4">
          <h4>Specializations</h4>
          <p class="small">
            Your first specialization is free. Additional specializations cost XP.
            Specializations grant additional career skills and may unlock talents.
          </p>

          <div class="row">
            <div class="col-md-6">
              <div class="input-group mb-2">
                <select class="form-select" {{on "change" (action "updateSpecSelection")}}>
                  <option value="">-- Select a Specialization --</option>
                  {{#each this.availableSpecs as |spec|}}
                    <option value={{spec.name}}>
                      {{spec.name}}
                      {{#if spec.career}}
                        ({{spec.career}})
                      {{else}}
                        (Universal)
                      {{/if}}
                    </option>
                  {{/each}}
                </select>
                <button 
                  class="btn btn-primary" 
                  {{on "click" (action "addSpecialization")}}
                  disabled={{not this.selectedSpecName}}
                >
                  Add
                </button>
              </div>
            </div>
          </div>

          {{#if this.char.custom.ffg.specializations}}
            <div class="mt-3">
              <strong>Your Specializations:</strong>
              <ul class="list-group mt-2">
                {{#each this.char.custom.ffg.specializations as |spec index|}}
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <strong>{{spec.name}}</strong>
                      {{#if spec.career}}
                        <span class="badge bg-secondary">{{spec.career}}</span>
                      {{else}}
                        <span class="badge bg-info">Universal</span>
                      {{/if}}
                      {{#if spec.force_user}}
                        <span class="badge bg-warning">Force User</span>
                      {{/if}}
                      {{#if (eq index 0)}}
                        <span class="badge bg-success">Free</span>
                      {{/if}}
                      {{#if spec.career_skills}}
                        <br>
                        <small>
                          Skills: 
                          {{#each spec.career_skills as |skill|}}
                            {{skill}}{{#if @last}}{{else}}, {{/if}}
                          {{/each}}
                        </small>
                      {{/if}}
                    </div>
                    <button 
                      class="btn btn-sm btn-danger" 
                      {{on "click" (fn this.removeSpecialization spec.name)}}
                    >
                      Remove
                    </button>
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>

    {{! Characteristics }}
    <div id="ffg-chars" class="tab-pane" role="tabpanel">
      <h3>Characteristics</h3>
      <p>
        Characteristics represent your character's raw physical and mental attributes.
        Maximum rating in chargen: {{this.char.custom.cg_ffg.max_cg_characteristic_rating}}
      </p>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Characteristic</th>
            <th>Description</th>
            <th class="text-center">Rating</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.char.custom.ffg.characteristics as |c|}}
            <FfgCharacteristicRow
              @charac={{c}}
              @maxRating={{this.char.custom.cg_ffg.max_cg_characteristic_rating}}
              @updated={{action "abilityChanged"}}
            />
          {{/each}}
        </tbody>
      </table>
    </div>

    {{! Skills }}
    <div id="ffg-skills" class="tab-pane" role="tabpanel">
      <h3>Skills</h3>
      <p>
        Skills represent your character's training and expertise.
        Maximum rating in chargen: {{this.char.custom.cg_ffg.max_cg_skill_rating}}
        <br>
        <strong>Career skills</strong> are highlighted and cost less XP to improve.
        You must take at least {{this.char.custom.cg_ffg.min_career_skills}} career skills.
      </p>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Skill</th>
            <th>Characteristic</th>
            <th class="text-center">Career Skill?</th>
            <th class="text-center">Rating</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.char.custom.ffg.skills as |s|}}
            <tr>
              <td>
                <strong>{{s.name}}</strong>
                {{#if s.desc}}
                  <br><small>{{s.desc}}</small>
                {{/if}}
              </td>
              <td>{{s.characteristic}}</td>
              <td class="text-center">
                {{#if s.is_career}}
                  <span class="badge bg-success">Yes</span>
                {{else}}
                  <span class="badge bg-secondary">No</span>
                {{/if}}
              </td>
              <td>
                <FfgSkillRow
                  @skill={{s}}
                  @maxRating={{this.char.custom.cg_ffg.max_cg_skill_rating}}
                  @updated={{action "abilityChanged"}}
                />
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{! Talents }}
    <div id="ffg-talents" class="tab-pane" role="tabpanel">
      <h3>Talents</h3>
      <p>
        Talents are special abilities that make your character unique.
        You must maintain a balanced talent pyramid - you need more talents at lower tiers
        to support higher tier talents.
      </p>
      <FfgTalentsList
        @char={{this.char.custom.ffg}}
        @cgInfo={{this.char.custom.cg_ffg}}
        @updated={{action "abilityChanged"}}
      />
    </div>
  </div>
</section>