<tr>
  <td>{{@charac.name}}</td>
  <td>{{@charac.desc}}</td>

  <td>
    <div class="fs3-rating-control">
      <button class="fs3-skillbutton" {{on "click" this.decrease}}>−</button>
      <span style="display:inline-block; width:2rem; text-align:center;">
        {{@charac.rating}}
      </span>
      <button class="fs3-skillbutton" {{on "click" this.increase}}>+</button>
    </div>
  </td>
</tr>
