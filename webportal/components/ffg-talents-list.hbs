{{!-- Pyramid summary --}}
<div class="mb-3">
  <strong>Your Talent Pyramid:</strong>
  <div class="mt-2">
    {{#each this.tierSummary as |row|}}
      <span style="display:inline-block; margin-right:1rem;">
        <strong>Tier {{row.tier}}:</strong> {{row.count}} talents
      </span>
    {{/each}}
  </div>
  <div class="mt-2">
    <span class="badge {{if this.isBalanced "bg-success" "bg-danger"}}">
      {{if this.isBalanced "✓ Pyramid is balanced" "✗ Pyramid needs balancing"}}
    </span>
  </div>
</div>

{{!-- Tier tabs --}}
<ul class="nav nav-tabs mb-3" role="tablist">
  {{#each this.tierTabs as |tier|}}
    <li class="nav-item" role="presentation">
      <button
        type="button"
        class="nav-link {{if (eq this.activeTier tier) "active"}}"
        role="tab"
        {{on "click" (fn this.selectTier tier)}}
      >
        Tier {{tier}}
      </button>
    </li>
  {{/each}}
</ul>

{{!-- Active tier table --}}
<div class="tab-content">
  {{#if this.activeTierTalents.length}}
    <table class="table table-sm table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th class="text-center">Ranked?</th>
          {{#if @cgInfo.use_force}}
            <th class="text-center">Force?</th>
          {{/if}}
          <th>Prerequisite</th>
          <th>Specializations</th>
          <th class="text-center">Current Rank</th>
          <th class="text-center">Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each this.activeTierTalents as |t|}}
          <tr class="{{unless t.isAvailable "table-secondary"}}">
            <td>
              <strong>{{t.name}}</strong>
              {{#unless t.isAvailable}}
                <br><small class="text-danger">{{t.unavailableReason}}</small>
              {{/unless}}
            </td>
            <td class="text-center">
              {{#if t.ranked}}
                <span class="badge bg-success">Yes</span>
              {{else}}
                <span class="badge bg-secondary">No</span>
              {{/if}}
            </td>
            {{#if @cgInfo.use_force}}
              <td class="text-center">
                {{#if t.force_power}}
                  <span class="badge bg-warning">Yes</span>
                {{else}}
                  <span class="badge bg-secondary">No</span>
                {{/if}}
              </td>
            {{/if}}
            <td>
              {{#if t.prereq}}
                {{t.prereq}}
              {{else}}
                —
              {{/if}}
            </td>
            <td>
              {{#if t.specializationsText}}
                <small>{{t.specializationsText}}</small>
              {{else}}
                <small>Any</small>
              {{/if}}
            </td>
            <td class="text-center">
              {{t.currentRank}}
            </td>
            <td class="text-center">
              {{#if t.hasTalent}}
                <button
                  type="button"
                  class="btn btn-sm btn-danger"
                  {{on "click" (fn this.removeTalentFromRow t)}}
                >
                  Remove
                </button>
              {{else}}
                <button
                  type="button"
                  class="btn btn-sm btn-primary"
                  {{on "click" (fn this.addTalentFromRow t)}}
                  disabled={{not t.canAdd}}
                  title="{{if t.canAdd "Add this talent" (if t.isAvailable "Would break pyramid balance" t.unavailableReason)}}"
                >
                  Add
                </button>
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <div class="alert alert-info">
      No talents available for Tier {{this.activeTier}}.
    </div>
  {{/if}}
</div>
