<div id="ffg-talents" class="tab-pane" role="tabpanel">
  {{!-- Pyramid summary --}}
  <div class="mb-2">
    {{#each this.tierSummary as |row|}}
      <span style="display:inline-block; margin-right:0.75rem; text-align:center;">
        <div><b>Tier {{row.tier}}</b></div>
        <div>{{row.count}}</div>
      </span>
    {{/each}}
  </div>

  <p style="margin:0 0 0.5rem 0; font-size:0.85em;">
    A valid talent pyramid has at least as many talents in lower tiers as in higher tiers.
    Current pyramid balanced? <b>{{if this.isBalanced "Yes" "No"}}</b>
  </p>

  {{!-- Tier tabs --}}
  <ul class="nav nav-tabs mb-2" role="tablist">
    {{#each this.tierTabs as |tier|}}
      <li class="nav-item" role="presentation">
        <button
          type="button"
          class="nav-link {{if (eq this.activeTier tier) "active"}}"
          role="tab"
          {{on "click" (fn this.selectTier tier)}}
        >
          Tier {{tier}}
        </button>
      </li>
    {{/each}}
  </ul>

  {{!-- Active tier table --}}
  <div class="tab-content">
    <div class="tab-pane active" role="tabpanel">
      {{#if this.activeTierTalents.length}}
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th>Name</th>
              <th class="text-center">Tier</th>
              <th class="text-center">Ranked?</th>
              <th class="text-center">Force?</th>
              <th>Prerequisite</th>
              <th>Specializations</th>
              <th class="text-center">Current Rank</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.activeTierTalents as |t|}}
              <tr>
                <td>{{t.name}}</td>
                <td class="text-center">{{t.tier}}</td>
                <td class="text-center">
                  {{#if t.ranked}}
                    <span class="badge bg-success">Yes</span>
                  {{else}}
                    <span class="badge bg-secondary">No</span>
                  {{/if}}
                </td>
                <td class="text-center">
                  {{#if t.force_power}}
                    <span class="badge bg-warning">Yes</span>
                  {{else}}
                    <span class="badge bg-secondary">No</span>
                  {{/if}}
                </td>
                <td>
                  {{#if t.prereq}}
                    {{t.prereq}}
                  {{else}}
                    &mdash;
                  {{/if}}
                </td>
                <td>
                  {{#if t.specializations}}
                    <small>{{t.specializationsText}}</small>
                  {{else}}
                    <small class="text-muted">Any</small>
                  {{/if}}
                </td>
                <td class="text-center">
                  {{t.currentRank}}
                </td>
                <td class="text-center">
                  {{#if t.hasTalent}}
                    <button
                      type="button"
                      class="btn btn-sm btn-danger"
                      {{on "click" (fn this.removeTalentFromRow t)}}
                    >
                      Remove
                    </button>
                  {{else}}
                    <button
                      type="button"
                      class="btn btn-sm btn-primary"
                      {{on "click" (fn this.addTalentFromRow t)}}
                      disabled={{not t.canAdd}}
                    >
                      Add
                    </button>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p>No talents defined for this tier.</p>
      {{/if}}
    </div>
  </div>
</div>