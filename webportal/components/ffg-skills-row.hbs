<div id="ffg-skills" class="tab-pane" role="tabpanel">
  {{!-- Header is rendered by parent so we don't duplicate it here --}}

  {{#if @char.skills}}
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Skill</th>
          <th class="text-center">Rating</th>
        </tr>
      </thead>
      <tbody>
        {{#each @char.skills as |s|}}
          <FfgSkillRow
            @skill={{s}}
            @maxRating={{@maxRating}}
            @updated={{@updated}}
          />
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No skills found in char.skills.</p>
  {{/if}}
</div>
